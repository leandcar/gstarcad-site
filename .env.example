# ===== Variáveis de ambiente (configurar no EasyPanel → App → Environment) =====
# Copie para um arquivo .env local (NÃO versionado) e preencha os valores reais.
# Em produção, defina cada uma na aba Environment do EasyPanel.

# --- Agendor (CRM) ---
# Token da API do Agendor. Sem ele, os formulários só usam WhatsApp (não criam lead no CRM).
AGENDOR_TOKEN=
# (Opcional) ID do funil. Default no código: 891975 (Funil de Vendas).
AGENDOR_FUNNEL_ID=
# (Opcional) ID da raia. Default no código: 3780288 (Contato).
AGENDOR_STAGE_ID=

# --- Download do instalador de avaliação ---
# ID do instalador WINDOWS no Google Drive ("qualquer pessoa com o link").
DRIVE_FILE_ID=
# ID do instalador macOS no Google Drive ("qualquer pessoa com o link").
DRIVE_FILE_ID_MAC=
# Segredo para assinar o token de download (string aleatória longa).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DOWNLOAD_SECRET=
# Chave para gerar links de download manuais em /admin/link (e /api/download-link).
# Sem ela, o gerador de links fica desativado.
ADMIN_KEY=
# (Alternativa ao Drive) Pasta de instaladores servidos em /arquivos (volume). Ex.: /data/arquivos
FILES_DIR=

# --- Servidor ---
# Porta do servidor Node. Default: 4000.
PORT=
